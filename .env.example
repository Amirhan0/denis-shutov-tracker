# Адрес сайта (для ссылок восстановления пароля)
APP_URL=https://shutov-psy.ru
# База Turso (на Vercel обязательно). Без этих переменных используется локальный файл ./data/app.db
TURSO_DATABASE_URL=libsql://...turso.io
TURSO_AUTH_TOKEN=
# Часовой пояс по умолчанию
APP_TZ=Europe/Moscow
# Автовыход при бездействии, минут
SESSION_IDLE_MINUTES=30

# Ссылки Дениса
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/...
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/...
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Почта для восстановления пароля (если не задано — ссылка пишется в лог сервера)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
