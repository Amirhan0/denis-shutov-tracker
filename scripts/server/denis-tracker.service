[Unit]
Description=Денис Шутов — платформа с трекерами
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/srv/denis/current
EnvironmentFile=/srv/denis/shared/.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
